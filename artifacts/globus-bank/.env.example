# Replit-managed Clerk values are provisioned by the Auth setup.
# Never paste secret values into this example file.
# CLERK_SECRET_KEY (managed secret)
# CLERK_PUBLISHABLE_KEY (managed value)
# VITE_CLERK_PUBLISHABLE_KEY (managed value)
# VITE_CLERK_PROXY_URL (managed for production)

# Comma-separated, server-only Clerk user IDs. Empty means no admin access.
GLOBUS_ADMIN_CLERK_IDS=

# DATABASE_URL, PORT and BASE_PATH are supplied by the managed workspace.
