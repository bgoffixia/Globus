{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "buildCommand": "pnpm run build"
    },
    "globus-bank": {
      "root": "artifacts/globus-bank",
      "framework": "vite",
      "buildCommand": "PORT=24083 BASE_PATH=/ NODE_ENV=production pnpm run build",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "globus-bank"
      }
    }
  ]
}