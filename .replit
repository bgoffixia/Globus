modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
GLOBUS_ADMIN_CLERK_IDS = "user_3Kh6wyO6bPqf1JcXaWPxo2CkOkd"
GLOBUS_ADMIN_EMAILS = "agbodave807@gmail.com"

[userenv.shared]

[userenv.production]
GLOBUS_ADMIN_EMAILS = "bg.offixia@gmail.com"

[objectStorage]
defaultBucketID = "replit-objstore-4961e80f-6330-48d1-850b-c59d962859e1"
